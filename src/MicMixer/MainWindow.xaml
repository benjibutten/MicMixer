        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MicMixer.UI"
        Title="MicMixer" Height="740" Width="900" MinHeight="540" MinWidth="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Window.Resources>
        <!-- Mic icon (clean cardioid mic outline) -->
