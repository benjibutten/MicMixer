        <!-- Skip previous icon -->
        <Geometry x:Key="SkipPrevIcon">M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z</Geometry>
        <!-- Skip next icon -->
        <Geometry x:Key="SkipNextIcon">M16,18H18V6H16M6,18L14.5,12L6,6V18Z</Geometry>
        <!-- Pause icon -->
        <Geometry x:Key="PauseIcon">M14,19H18V5H14M6,19H10V5H6V19Z</Geometry>
        <!-- Queue (playlist plus) icon -->
        <Geometry x:Key="QueueIcon">M2,16H10V14H2M18,14V10H16V14H12V16H16V20H18V16H22V14M2,12H14V10H2M2,8H14V6H2V8Z</Geometry>
        <!-- Headphones icon -->
        <Geometry x:Key="HeadphonesIcon">M12,1C7.03,1 3,5.03 3,10V17A3,3 0 0,0 6,20H9V12H5V10A7,7 0 0,1 12,3A7,7 0 0,1 19,10V12H15V20H18A3,3 0 0,0 21,17V10C21,5.03 16.97,1 12,1Z</Geometry>
        <!-- Search icon -->
        <Geometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <!-- Close / clear icon -->
        <Geometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <!-- Chevron up icon (queue chip) -->
        <Geometry x:Key="ChevronUpIcon">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</Geometry>
        <!-- Drag handle icon (two dot columns) -->
        <Geometry x:Key="DragHandleIcon">M9,3H11V5H9V3M13,3H15V5H13V3M9,8H11V10H9V8M13,8H15V10H13V8M9,13H11V15H9V13M13,13H15V15H13V13</Geometry>
        <!-- Play/pause combined glyph (media key transport in external mode) -->
        <Geometry x:Key="PlayPauseGlyph">M3,5V19L11,12M13,19H16V5H13M18,5V19H21V5</Geometry>
        <!-- Single-track icon: box with a "1" (play only this track, then stop) -->
        <Geometry x:Key="SingleTrackIcon">M14,17H12V9H10V7H14V17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19Z</Geometry>
        <!-- Timed play icon: play triangle inside a dashed clock circle (delayed start) -->
        <Geometry x:Key="TimedPlayIcon">M13,2.05C18.05,2.55 22,6.82 22,12C22,17.18 18.05,21.45 13,21.95V19.93C16.95,19.44 20,16.08 20,12C20,7.92 16.95,4.56 13,4.07V2.05M11,2.05V4.07C9.43,4.27 8,4.89 6.77,5.82L5.36,4.36C7,3.11 8.87,2.3 11,2.05M4.36,5.36L5.82,6.77C4.89,8 4.27,9.43 4.07,11H2.05C2.3,8.87 3.11,7 4.36,5.36M2.05,13H4.07C4.27,14.57 4.89,16 5.82,17.23L4.36,18.64C3.11,17 2.3,15.13 2.05,13M6.77,18.18C8,19.11 9.43,19.73 11,19.93V21.95C8.87,21.7 7,20.89 5.36,19.64L6.77,18.18M16,12L10,16V8L16,12Z</Geometry>
        <!-- Speaker / secondary output icon -->
        <Geometry x:Key="SpeakerIcon">M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z</Geometry>
        <!-- Chain link icon (volume sync) -->
        <Geometry x:Key="LinkIcon">M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z</Geometry>

        <!-- Slim scrollbar: 8 px rounded thumb, no arrow buttons, transparent track.
             Implicit style, so every scrollbar (settings pages, playlist, queue,
             dropdowns) gets the same look; the settings window shares these resources. -->
        <Style x:Key="SlimScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SlimScrollThumb" TargetType="Thumb">
            <Border x:Name="ThumbBg" Background="#C9D2DD" CornerRadius="4"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbBg" Property="Background" Value="#A9B6C6"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbBg" Property="Background" Value="#8B9BAE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="SlimScrollBarVertical" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SlimScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SlimScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource SlimScrollThumb}" Margin="1,0" MinHeight="24"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="SlimScrollBarHorizontal" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SlimScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource SlimScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Template="{StaticResource SlimScrollThumb}" Margin="0,1" MinWidth="24"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template" Value="{StaticResource SlimScrollBarVertical}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template" Value="{StaticResource SlimScrollBarHorizontal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented mode switch (music source) -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#5B6B7C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBg" Background="Transparent" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#10233A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#10233A"/>
                                <Setter TargetName="SegmentBg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared icon style helper -->
        <Style x:Key="SectionIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Info-tooltip helpers: (i) icon next to a section label with an explanatory tooltip -->
        <Style x:Key="InfoTipHost" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        </Style>
        <Style x:Key="InfoTipIcon" TargetType="Path" BasedOn="{StaticResource SectionIcon}">
            <Setter Property="Data" Value="{StaticResource InfoIcon}"/>
            <Setter Property="Fill" Value="#9CA3AF"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style x:Key="TipTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TipBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="300"/>
        </Style>

        <!-- Settings window typography and navigation -->
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#10233A"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SettingsDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="540"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingsSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
        <Style x:Key="SettingsPage" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="22,18,22,8"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="SettingsNavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#5B6B7C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavBg" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,0,0,2">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#10233A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#10233A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="NavBg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One step in the "where does the sound go" chain on the Devices page -->
        <Style x:Key="FlowStep" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="FlowArrow" TargetType="TextBlock">
            <Setter Property="Text" Value="→"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header row: title + settings -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MicMixer" FontSize="22" FontWeight="SemiBold" Foreground="#10233A"/>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#9CA3AF" Margin="8,0,0,4"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
            <Button Grid.Column="1" Click="OnSettingsClick" Height="32" Padding="12,0" VerticalAlignment="Center"
                    Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"
                    ToolTip="Devices, hotkey, noise gate, overlay and everything else">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CogIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status strip: the whole chain summarized on one card -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="12" Background="White" BorderBrush="#D7DEE7" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="StatePill" CornerRadius="14" Padding="6,5,12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="StatePillDot"/>
                            <Path x:Name="StatePillGlyph" Fill="White" Width="10" Height="10" Stretch="Uniform"/>
                        </Grid>
                        <TextBlock x:Name="StatePillText" Margin="7,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HotkeyStateText" FontSize="12" Foreground="#10233A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OverviewText" Margin="0,2,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
                    <!-- Transient messages: start checks, errors. Gone when empty. -->
                    <TextBlock x:Name="StatusText" Margin="0,3,0,0" FontSize="11" Foreground="#9A3412" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="ToggleBtn" Grid.Column="2" Click="OnToggleClick" Height="32" Padding="14,0" FontWeight="SemiBold"
                        VerticalAlignment="Center" Background="#10233A" Foreground="White" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="ToggleBtnIcon" Data="{StaticResource PlayIcon}" Fill="White"
                              Style="{StaticResource SectionIcon}" Width="13" Height="13" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ToggleBtnText" Text="Enable" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Voice changer switch: switched during a session, so it lives here and
                     not only in settings. A running route restarts for a moment. -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#E9EEF3" BorderThickness="0,1,0,0">
                    <WrapPanel>
                        <TextBlock Text="Voice changer" FontSize="12" FontWeight="SemiBold" Foreground="#10233A" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <Border x:Name="VoiceSwitchPanel" Background="#E8EEF5" CornerRadius="8" Padding="2" VerticalAlignment="Center"
                                ToolTipService.ShowDuration="30000"
                                ToolTip="What others hear while you hold the hotkey. Takes effect right away; if routing is on, it restarts for a moment.">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="VoiceOffRadio" Style="{StaticResource ModeSegment}" GroupName="VoiceChanger"
                                             Content="Off" Checked="OnVoiceSwitchChecked" MinWidth="56"/>
                                <RadioButton x:Name="VoiceAppRadio" Style="{StaticResource ModeSegment}" GroupName="VoiceChanger"
                                             Content="Voice changer app" Checked="OnVoiceSwitchChecked"/>
                                <RadioButton x:Name="VoiceMicMixerRadio" Style="{StaticResource ModeSegment}" GroupName="VoiceChanger"
                                             Content="MicMixer voices" Checked="OnVoiceSwitchChecked"/>
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="QuickVoiceProfileCombo" Width="190" Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="OnVoiceProfileChanged"
                                  AutomationProperties.Name="MicMixer voice"/>
                        <TextBlock x:Name="VoiceSwitchHint" Margin="10,0,0,0" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </WrapPanel>
                </Border>

                <!-- Diagnostic marker: same as the Pause key, for when a button is easier to find. -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#E9EEF3" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MarkerBtn" Click="OnMarkerClick" Height="28" Padding="10,0" FontSize="11.5" FontWeight="SemiBold"
                                Content="Mark: seen talking now"
                                ToolTip="Writes a marker line to the log with the current gate, hotkey and volume state. Pause on the keyboard does the same."/>
                        <TextBlock x:Name="MarkerText" Margin="10,0,0,0" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Problems: one card per thing that is wrong, each with the button that fixes it.
             Empty (and therefore invisible) when everything is as saved. -->
        <ItemsControl x:Name="ProblemsList" Grid.Row="2" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="10" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="#9A3412" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{Binding ActionText}" Click="OnProblemActionClick"
                                    Margin="12,0,0,0" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                    Background="White" Foreground="#9A3412" BorderBrush="#FDBA74" BorderThickness="1"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Music player, full width -->
        <ui:MusicPanel Grid.Row="3" Padding="14" Background="White"
                       BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header + monitoring switch (the device itself is chosen in settings) -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource MusicIcon}" Fill="#7C3AED" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Music into the mic channel" FontWeight="SemiBold" FontSize="12" Foreground="#10233A" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource InfoTipHost}">
                            <Path Style="{StaticResource InfoTipIcon}"/>
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TipTitle}" Text="How music works"/>
                                        <TextBlock Style="{StaticResource TipBody}"
                                                   Text="Music is mixed into the mic channel with your voice so others can hear it whenever a track is playing and routing is active."/>
                                        <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                                   Text="In MP3 / YouTube mode, download tracks from a YouTube link or add your own MP3 files to the music folder (folder icon on the right; Settings › Music folders lets you add more folders). In External app mode, audio from a music app is captured and mixed in directly."/>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="MonitorEnabledCheck" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#10233A"
                              Checked="OnMonitorConfigChanged" Unchecked="OnMonitorConfigChanged"
                              ToolTipService.ShowDuration="60000" ToolTipService.ShowOnDisabled="True"
                              ToolTip="Also play the music through your own headphones or speakers (chosen in Settings › Devices) so you can hear it. This does not affect what others hear. Monitoring is not needed in app mode because you hear the app directly.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HeadphonesIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Monitoring" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </Grid>

                <!-- Source mode switch: local library vs external app capture -->
                <Border Grid.Row="1" Margin="0,0,0,8" Background="#E8EEF5" CornerRadius="8" Padding="2">
                    <UniformGrid Rows="1" Columns="2">
                        <RadioButton x:Name="LibraryModeRadio" Style="{StaticResource ModeSegment}" GroupName="MusicMode"
                                     IsChecked="True" Checked="OnMusicModeChanged" Content="MP3 / YouTube"
                                     ToolTip="Play downloaded MP3 files from the music folder."/>
                        <RadioButton x:Name="ExternalModeRadio" Style="{StaticResource ModeSegment}" GroupName="MusicMode"
                                     Checked="OnMusicModeChanged" Content="External app"
                                     ToolTip="Capture audio from an app playing music and mix it into the mic channel. Control playback in the app."/>
                    </UniformGrid>
                </Border>

                <!-- Download panel: URL, target folder and progress share one state/render boundary. -->
                <ui:DownloadPanel Grid.Row="2" Grid.RowSpan="2">
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <!-- YouTube URL row -->
                <Grid x:Name="YoutubeRow" Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="YoutubeUrlBox" Height="28" Padding="5,0,3,0" VerticalContentAlignment="Center" FontSize="11.5"
                                 KeyDown="OnYoutubeUrlKeyDown" TextChanged="OnYoutubeUrlChanged"/>
                        <TextBlock x:Name="YoutubeUrlHintText" Text="Paste a YouTube link here..." FontSize="11.5"
                                   Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Download target folder — only shown when more than one music folder is active -->
                    <ComboBox x:Name="DownloadFolderCombo" Grid.Column="1" Height="28" MaxWidth="150" Margin="8,0,0,0"
                              Visibility="Collapsed" FontSize="11" VerticalContentAlignment="Center"
                              SelectionChanged="OnDownloadFolderChanged"
                              ToolTipService.ShowDuration="60000"
                              ToolTip="Folder for new downloads">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" ToolTipService.ShowDuration="60000">
                                    <Border Background="{Binding Tint}" CornerRadius="6" Padding="5,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Letter}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding Accent}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="DownloadBtn" Grid.Column="2" Height="28" Margin="8,0,0,0" Padding="10,0"
                            Click="OnDownloadClick" FontSize="11.5" FontWeight="SemiBold"
                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DownloadIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Download MP3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Download progress -->
                <Grid Grid.Row="1" x:Name="DownloadStatusRow" Visibility="Collapsed" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Foreground="#7C3AED" Background="#E5E7EB"/>
                    <TextBlock x:Name="DownloadStatusText" Grid.Column="1" Margin="8,0,0,0" FontSize="10.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                </Grid>
                  </Grid>
                </ui:DownloadPanel>

                <!-- Search / filter -->
                <Grid x:Name="SearchRow" Grid.Row="4" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource SearchIcon}" Fill="#9CA3AF" Style="{StaticResource SectionIcon}" Width="13" Height="13" Margin="0,0,6,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="PlaylistFilterBox" Height="26" Padding="5,0,3,0" VerticalContentAlignment="Center" FontSize="11.5"
                                 TextChanged="OnPlaylistFilterChanged"/>
                        <TextBlock x:Name="PlaylistFilterHintText" Text="Search the playlist..." FontSize="11.5"
                                   Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Folder filter chips — one per music folder, shown when several folders are active.
                         Toggling a chip narrows the list to that folder; no active chip shows everything. -->
                    <ItemsControl x:Name="FolderChipsPanel" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsActive, Mode=TwoWay}" Click="OnFolderChipClick" Cursor="Hand"
                                              Margin="4,0,0,0" Opacity="{Binding ChipOpacity}"
                                              ToolTip="{Binding ToolTipText}" ToolTipService.ShowDuration="60000">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{Binding ChipBackground}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0">
                                                <TextBlock Text="{Binding Letter}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding ChipForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Playlist (fills remaining height). The button column moves to a
                     horizontal row under the list when height is scarce (code-behind). -->
                <Grid x:Name="PlaylistRow" Grid.Row="5" Margin="0,0,0,8" SizeChanged="OnPlaylistRowSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="PlaylistListBox" FontSize="11.5" MinHeight="96"
                             MouseDoubleClick="OnPlaylistDoubleClick" BorderBrush="#D7DEE7"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,3"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource PlayIcon}" Fill="#7C3AED" Width="9" Height="9" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{Binding PlayingVisibility}"/>
                                    <!-- Folder badge: first letter of the source folder, shown when several folders are active -->
                                    <Border Grid.Column="1" Background="{Binding FolderBadgeBackground}" CornerRadius="6" Padding="5,1" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Visibility="{Binding FolderBadgeVisibility}"
                                            ToolTip="{Binding FolderPath}" ToolTipService.ShowDuration="60000">
                                        <TextBlock Text="{Binding FolderLetter}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding FolderBadgeForeground}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="3" Background="#EDE9FE" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Visibility="{Binding QueueVisibility}"
                                            ToolTip="Queue position">
                                        <TextBlock Text="{Binding QueueText}" FontSize="10" FontWeight="SemiBold" Foreground="#7C3AED"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="PlaylistButtonsPanel" Grid.Column="1" Margin="8,0,0,0">
                        <Button Height="28" Width="28" Padding="0" Click="OnQueueClick" ToolTip="Add the selected track to the queue"
                                Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                            <Path Data="{StaticResource QueueIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button Height="28" Width="28" Padding="0" Margin="0,6,0,0" Click="OnPlaylistRefreshClick" ToolTip="Refresh the playlist"
                                Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                            <Path Data="{StaticResource RefreshIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="OpenMusicFolderBtn" Height="28" Width="28" Padding="0" Margin="0,6,0,0" Click="OnOpenMusicFolderClick" ToolTip="Open the music folder"
                                Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                            <Path Data="{StaticResource FolderIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- External app capture (replaces the library rows in external mode) -->
                <Grid x:Name="ExternalPanel" Grid.Row="2" Grid.RowSpan="4" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- App picker + capture toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ExternalAppCombo" Height="28" VerticalContentAlignment="Center" FontSize="11.5"
                                  DisplayMemberPath="FriendlyName" SelectionChanged="OnExternalAppSelectionChanged"
                                  ToolTipService.ShowDuration="60000"
                                  ToolTip="The list shows apps that have created an audio session in Windows. A newly started app therefore appears only after it has played audio."/>
                        <Button Grid.Column="1" Height="28" Width="28" Margin="6,0,0,0" Padding="0"
                                Click="OnRefreshAudioAppsClick" ToolTip="Refresh after the app has played audio"
                                Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                            <Path Data="{StaticResource RefreshIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="CaptureToggleBtn" Grid.Column="2" Height="28" Margin="8,0,0,0" Padding="10,0"
                                Click="OnCaptureToggleClick" FontSize="11.5" FontWeight="SemiBold"
                                Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED" BorderThickness="1"
                                ToolTipService.ShowDuration="60000"
                                ToolTip="Starts or stops only audio capture from the app. Routing (the button in the top right) is not affected.">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="CaptureToggleIcon" Data="{StaticResource PlayIcon}" Fill="White"
                                      Style="{StaticResource SectionIcon}" Width="11" Height="11" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CaptureToggleText" Text="Capture audio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="2,0,2,8" FontSize="10.5" Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Text="The list shows apps with an audio session. If an app is missing, play something in it for a few seconds, then click Refresh."/>

                    <!-- Capture status card -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E9EEF3" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="CaptureStateIcon" Data="{StaticResource CircleOffIcon}" Fill="#9CA3AF"
                                  Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="CaptureStateText" Text="No audio capture" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="#10233A" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="340"/>
                            <ProgressBar x:Name="CaptureLevelMeter" Width="220" Height="8" Minimum="0" Maximum="1"
                                         Margin="0,10,0,0" Foreground="#7C3AED" Background="#E5E7EB"/>
                            <TextBlock x:Name="CaptureHintText" Margin="0,10,0,0" FontSize="10.5" Foreground="#9CA3AF"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                                       Text="Select the app playing music and click Capture audio. Control playback in the app as usual — its audio is mixed into the mic channel."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Contextual warning: playback/capture can be audible locally even though
                     nothing is currently being sent to the mic channel. -->
                <Border x:Name="MusicRoutingWarning" Grid.Row="6" Margin="0,0,0,8" Padding="10,7"
                        Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                        CornerRadius="7" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="!" Width="18" Height="18" Margin="0,0,8,0"
                                   VerticalAlignment="Top" TextAlignment="Center"
                                   FontSize="11" FontWeight="Bold" Foreground="#9A3412"
                                   Background="#FFEDD5"/>
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#9A3412" TextWrapping="Wrap"
                                   Text="Routing is off. Music is heard only locally and is not sent to the mic channel — enable routing to let others hear it."/>
                    </Grid>
                </Border>

                <!-- Transport -->
                <Grid Grid.Row="7" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Height="30" Width="30" Padding="0" Click="OnPrevTrackClick" ToolTip="Previous / restart"
                            Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                        <Path Data="{StaticResource SkipPrevIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="13" Height="13"/>
                    </Button>
                    <Button Grid.Column="1" Height="30" Width="38" Padding="0" Margin="6,0,0,0" Click="OnPlayPauseClick" ToolTip="Play / pause"
                            Background="#10233A" BorderThickness="0">
                        <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayIcon}" Fill="White" Style="{StaticResource SectionIcon}" Width="13" Height="13"/>
                    </Button>
                    <Button Grid.Column="2" Height="30" Width="30" Padding="0" Margin="6,0,0,0" Click="OnStopPlaybackClick"
                            ToolTip="Stop and deselect the active track"
                            Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                        <Path Data="{StaticResource StopIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12"/>
                    </Button>
                    <Button Grid.Column="3" Height="30" Width="30" Padding="0" Margin="6,0,0,0" Click="OnNextTrackClick" ToolTip="Next track"
                            Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                        <Path Data="{StaticResource SkipNextIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="13" Height="13"/>
                    </Button>
                    <!-- Delayed start: arm a countdown, then play — time to alt-tab back to the game.
                         Right-click picks the delay length; clicking again mid-countdown cancels. -->
                    <Button x:Name="DelayedPlayBtn" Grid.Column="4" Height="30" MinWidth="48" Padding="8,0" Margin="12,0,0,0"
                            Click="OnDelayedPlayClick" FontSize="11.5" FontWeight="SemiBold"
                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"
                            ToolTipService.ShowDuration="60000">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="DelayedPlayIcon" Data="{StaticResource TimedPlayIcon}" Fill="#10233A"
                                  Style="{StaticResource SectionIcon}" Width="13" Height="13" Margin="0,0,5,0"/>
                            <TextBlock x:Name="DelayedPlayText" Text="3 s" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="Delayed playback"/>
                                    <TextBlock Style="{StaticResource TipBody}"
                                               Text="A play button with a countdown: click it to start the music after a few seconds, giving you time to switch back to the game before the track begins. Click again during the countdown to cancel."/>
                                    <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                               Text="Right-click the button to select the delay duration."/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="DelayedStartMenu" Opened="OnDelayedStartMenuOpened">
                                <MenuItem Header="Delay before playback" IsEnabled="False" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="1 second" Tag="1" Click="OnDelayedStartOptionClick"/>
                                <MenuItem Header="2 seconds" Tag="2" Click="OnDelayedStartOptionClick"/>
                                <MenuItem Header="3 seconds" Tag="3" Click="OnDelayedStartOptionClick"/>
                                <MenuItem Header="5 seconds" Tag="5" Click="OnDelayedStartOptionClick"/>
                                <MenuItem Header="10 seconds" Tag="10" Click="OnDelayedStartOptionClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Single-track mode: stop when the current track ends instead of auto-advancing.
                         Three states driven by Tag from code-behind: Off, Once (tinted — resets
                         itself after the track), Always (solid purple — double-click, stays on). -->
                    <Button x:Name="SingleTrackBtn" Grid.Column="5" Height="30" Width="30" Margin="6,0,0,0" Cursor="Hand"
                            Tag="Off" PreviewMouseLeftButtonDown="OnSingleTrackMouseDown"
                            ToolTipService.ShowDuration="60000" ToolTipService.ShowOnDisabled="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SingleTrackBg" Background="#E8EEF5" BorderBrush="#D7DEE7" BorderThickness="1">
                                    <Path x:Name="SingleTrackIconPath" Data="{StaticResource SingleTrackIcon}" Fill="#10233A"
                                          Width="13" Height="13" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SingleTrackBg" Property="Background" Value="#DDE6F0"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Once">
                                        <Setter TargetName="SingleTrackBg" Property="Background" Value="#EDE9FE"/>
                                        <Setter TargetName="SingleTrackBg" Property="BorderBrush" Value="#7C3AED"/>
                                        <Setter TargetName="SingleTrackIconPath" Property="Fill" Value="#7C3AED"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Always">
                                        <Setter TargetName="SingleTrackBg" Property="Background" Value="#7C3AED"/>
                                        <Setter TargetName="SingleTrackBg" Property="BorderBrush" Value="#7C3AED"/>
                                        <Setter TargetName="SingleTrackIconPath" Property="Fill" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="Play one track only"/>
                                    <TextBlock Style="{StaticResource TipBody}"
                                               Text="Single click: music stops when the current track ends, then the mode turns itself off. Ideal when you want to play just one track."/>
                                    <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                               Text="Double-click: the mode stays on (the button becomes solid purple), and music stops after every track until you turn it off."/>
                                    <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                               Text="The queue remains and the Next button works as usual — only automatic advancement is stopped."/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Slider x:Name="SeekSlider" Grid.Column="6" Margin="12,0,8,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted" ValueChanged="OnSeekValueChanged"/>
                    <TextBlock x:Name="ExternalTransportHint" Grid.Column="6" Margin="12,0,8,0" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="The buttons send media keys to the app that is playing."/>
                    <TextBlock x:Name="TrackTimeText" Grid.Column="7" Text="0:00 / 0:00" FontSize="11" Foreground="#6B7280"
                               VerticalAlignment="Center" MinWidth="76" TextAlignment="Right"/>
                </Grid>

                <!-- Volumes (drag only — no jump on track click). Folds into two
                     stacked rows when the card is narrow (handled in code-behind). -->
                <Grid x:Name="VolumesGrid" Grid.Row="8" SizeChanged="OnVolumesGridSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="MonitorSliderColumn" Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MusicVolumeLabel" Text="Music volume" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="MusicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            LargeChange="0" SmallChange="0.05"
                            ValueChanged="OnMusicVolumeChanged" ToolTip="How loud others hear the music (in the mic channel)"/>
                    <TextBlock x:Name="MusicVolumePercentText" Grid.Column="2" Text="50 %" FontSize="11" Foreground="#10233A"
                               FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="34" TextAlignment="Right"/>
                    <ToggleButton x:Name="VolumeLinkToggle" Grid.Column="3" Width="24" Height="24" Margin="6,0" Cursor="Hand"
                                  Checked="OnVolumeLinkChanged" Unchecked="OnVolumeLinkChanged"
                                  ToolTipService.ShowDuration="60000" ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Link volumes — drag one slider and the other follows while preserving the difference between them. If a slider reaches 0 or maximum, it stays there, but the difference returns when you drag the other way.">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="LinkBg" Background="Transparent" CornerRadius="6">
                                    <Path x:Name="LinkIconPath" Data="{StaticResource LinkIcon}" Fill="#9CA3AF" Width="14" Height="14"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LinkBg" Property="Background" Value="#E8EEF5"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="LinkBg" Property="Background" Value="#EDE9FE"/>
                                        <Setter TargetName="LinkIconPath" Property="Fill" Value="#7C3AED"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock x:Name="MonitorVolumeLabel" Grid.Column="4" Text="Monitoring" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="MonitorVolumeSlider" Grid.Column="5" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            LargeChange="0" SmallChange="0.05"
                            ValueChanged="OnMonitorVolumeChanged" ToolTip="How loud the music is in your own headphones"/>
                    <TextBlock x:Name="MonitorVolumePercentText" Grid.Column="6" Text="50 %" FontSize="11" Foreground="#10233A"
                               FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="34" TextAlignment="Right"/>
                </Grid>

                <!-- Music routing: how the music relates to push-to-talk and the cable.
                     Both are honest-by-default toggles — the hint text and the overlay's
                     music circle always tell where the music actually goes. -->
                <StackPanel Grid.Row="9" Margin="0,8,0,0">
                    <CheckBox x:Name="MusicIgnorePttCheck" FontSize="11.5" Foreground="#10233A"
                              Checked="OnMusicRoutingModeChanged" Unchecked="OnMusicRoutingModeChanged"
                              ToolTipService.ShowDuration="60000" ToolTipService.ShowOnDisabled="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource MusicIcon}" Fill="#7C3AED" Style="{StaticResource SectionIcon}" Width="12" Height="12" Margin="0,0,5,0"/>
                            <TextBlock Grid.Column="1" Text="Music ignores push-to-talk — music is transmitted while playing" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="Music bypasses push-to-talk"/>
                                    <TextBlock Style="{StaticResource TipBody}"
                                               Text="When this is on, music continues into the mic channel even while push-to-talk mutes the mic — ideal when the game should always hear the music but your voice is transmitted only while you hold the hotkey."/>
                                    <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                               Text="The mic always follows push-to-talk as usual. This option is active only when push-to-talk is on — without push-to-talk, music is transmitted whenever it plays."/>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox x:Name="MusicMonitorOnlyCheck" Margin="0,6,0,0" FontSize="11.5" Foreground="#10233A"
                              Checked="OnMusicRoutingModeChanged" Unchecked="OnMusicRoutingModeChanged"
                              ToolTipService.ShowDuration="60000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource HeadphonesIcon}" Fill="#D97706" Style="{StaticResource SectionIcon}" Width="12" Height="12" Margin="0,0,5,0"/>
                            <TextBlock Grid.Column="1" Text="Monitor only — preview without transmitting to the mic channel" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TipTitle}" Text="Preview the music"/>
                                    <TextBlock Style="{StaticResource TipBody}"
                                               Text="When this is on, music is never sent to the mic channel — only you hear it through monitoring, so you can preview a track or set the volume before others hear it. The mic is not affected."/>
                                    <TextBlock Style="{StaticResource TipBody}" Margin="0,6,0,0"
                                               Text="If the secondary output is active, it still receives the music — so your stream hears the same thing you do. The overlay's music circle shows amber headphones while this mode is on."/>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <TextBlock x:Name="MusicRouteHintText" Margin="0,5,0,0" FontSize="10.5" Foreground="#9A3412"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Now playing + hints -->
                <Grid Grid.Row="10" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- MinHeight reserves two text lines so status changes don't reflow the
                         card and shift the transport buttons mid-interaction. -->
                    <TextBlock x:Name="MusicStatusText" FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap"
                               MinHeight="28"
                               Text="Double-click a track to play it. Music is mixed with the mic while routing is active."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="QueueChipBtn" Visibility="Collapsed" Cursor="Hand" Margin="8,0,0,0"
                                      Checked="OnQueueChipChecked" ToolTipService.ShowDuration="30000"
                                      ToolTip="Show the queue — drag tracks to reorder them">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ChipBg" Background="#EDE9FE" CornerRadius="8" Padding="7,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="#7C3AED" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource ChevronUpIcon}" Fill="#7C3AED" Width="9" Height="9"
                                                  Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChipBg" Property="Background" Value="#DDD6FE"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChipBg" Property="Background" Value="#DDD6FE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button x:Name="ClearQueueBtn" Height="18" Width="18" Padding="0" Margin="4,0,0,0" Visibility="Collapsed"
                                Click="OnClearQueueClick" ToolTip="Clear the queue" Background="Transparent" BorderThickness="0">
                            <Path Data="{StaticResource CloseIcon}" Fill="#7C3AED" Style="{StaticResource SectionIcon}" Width="10" Height="10"/>
                        </Button>
                        <Popup x:Name="QueuePopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               PlacementTarget="{Binding ElementName=QueueChipBtn}" Placement="Top"
                               IsOpen="{Binding IsChecked, ElementName=QueueChipBtn, Mode=TwoWay}"
                               Closed="OnQueuePopupClosed">
                            <Border Background="White" BorderBrush="#C9D2DD" BorderThickness="1" CornerRadius="10" Padding="10" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <Grid Width="300">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Upcoming tracks" FontWeight="SemiBold" FontSize="11.5" Foreground="#10233A" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Height="20" Padding="6,0" Click="OnClearQueueClick" Content="Clear"
                                                FontSize="10.5" Background="#F3F4F6" Foreground="#6B7280" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                    </Grid>
                                    <ListBox x:Name="QueueListBox" Grid.Row="1" MaxHeight="250" BorderThickness="0" Background="Transparent"
                                             FontSize="11.5" AllowDrop="True"
                                             VirtualizingPanel.IsVirtualizing="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonDown="OnQueueListMouseDown"
                                             PreviewMouseMove="OnQueueListMouseMove"
                                             DragOver="OnQueueListDragOver" Drop="OnQueueListDrop" DragLeave="OnQueueListDragLeave"
                                             MouseDoubleClick="OnQueueListDoubleClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="2,0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border Height="2" Background="#7C3AED" CornerRadius="1" Visibility="{Binding InsertAboveVisibility}"/>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource DragHandleIcon}" Fill="#C4B5FD" Width="10" Height="12"
                                                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="SizeAll"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding NumberText}" Foreground="#7C3AED" FontWeight="SemiBold"
                                                                   MinWidth="18" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="3" Width="18" Height="18" Padding="0" Margin="6,0,0,0"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Click="OnQueueRemoveClick" Tag="{Binding}" ToolTip="Remove from the queue">
                                                            <Path Data="{StaticResource CloseIcon}" Fill="#9CA3AF" Width="9" Height="9" Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                    <Border Height="2" Background="#7C3AED" CornerRadius="1" Visibility="{Binding InsertBelowVisibility}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap"
                                               Text="Drag to reorder · Double-click to play immediately"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:MusicPanel>

        <!-- Project and contributor footer -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12,8"
                Background="#E8EDF3" BorderBrush="#D7DEE7" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="#526173" TextWrapping="Wrap">
                    <Run Text="Like MicMixer? Consider gifting a subscription to "/>
                    <Hyperlink NavigateUri="https://www.twitch.tv/pixlexi"
                               RequestNavigate="OnGuideNavigate"
                               Foreground="#7C3AED" FontWeight="SemiBold">Pixlexi</Hyperlink><Run Text=" on Twitch."/>
                </TextBlock>
                <Button Grid.Column="1" Margin="14,0,0,0" Padding="10,4"
                        Click="OnAboutClick" Content="More information"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Background="#F8FAFC" Foreground="#334155"
                        BorderBrush="#C9D2DD" BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- Settings. Declared here so MainWindow keeps owning these controls and their
             handlers, but never shown here: ShowSettings moves SettingsContent into
             its own window the first time it is opened. -->
        <Border x:Name="SettingsHost" Grid.Row="0" Visibility="Collapsed">
            <Grid x:Name="SettingsContent" Background="#F3F5F7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Explains the locked controls once, instead of leaving them silently gray
                     while routing runs. -->
                <Border x:Name="RoutingLockBanner" Padding="16,10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11.5" Foreground="#1E3A8A" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="Routing is on, so some settings are locked." FontWeight="SemiBold"/>
                            <Run Text="The microphones, the virtual cable and the secondary output are held open while audio flows, and creating or deleting a voice needs the microphone. Stop routing to change them. Everything else, including switching voices, works live."/>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Stop routing" Click="OnStopRoutingClick" Margin="12,0,0,0" Padding="10,4" FontSize="11.5"
                                VerticalAlignment="Center" Background="White" Foreground="#1E3A8A" BorderBrush="#BFDBFE" BorderThickness="1"/>
                    </Grid>
                </Border>

                <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="Transparent" Padding="0"
                            ItemContainerStyle="{StaticResource SettingsNavItem}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="#E5EAF0" BorderThickness="0,0,1,0" Padding="8,14">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- Devices -->
                    <TabItem x:Name="DevicesPage" Header="Devices">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel>
                                <!-- The chain first: every choice below is one link in it. -->
                                <Border Margin="0,0,0,20" Padding="12,10" CornerRadius="10" Background="#EEF2F7">
                                    <StackPanel>
                                        <TextBlock Text="Where your sound goes" Style="{StaticResource SettingsHeading}"/>
                                        <WrapPanel Margin="0,4,0,6">
                                            <Border Style="{StaticResource FlowStep}"><TextBlock Text="Mic + music" FontSize="11.5"/></Border>
                                            <TextBlock Style="{StaticResource FlowArrow}"/>
                                            <Border Style="{StaticResource FlowStep}"><TextBlock Text="MicMixer" FontSize="11.5"/></Border>
                                            <TextBlock Style="{StaticResource FlowArrow}"/>
                                            <Border Style="{StaticResource FlowStep}" BorderBrush="#A5B4FC"><TextBlock Text="CABLE Input" FontSize="11.5" FontWeight="SemiBold" Foreground="#4338CA"/></Border>
                                            <TextBlock Style="{StaticResource FlowArrow}" Text="⇢"/>
                                            <Border Style="{StaticResource FlowStep}" BorderBrush="#A5B4FC"><TextBlock Text="CABLE Output" FontSize="11.5" FontWeight="SemiBold" Foreground="#4338CA"/></Border>
                                            <TextBlock Style="{StaticResource FlowArrow}"/>
                                            <Border Style="{StaticResource FlowStep}"><TextBlock Text="Game or chat" FontSize="11.5"/></Border>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource SettingsDesc}" Margin="0"
                                                   Text="A virtual cable is a pipe with two ends. Whatever is played into CABLE Input comes out of CABLE Output, which apps see as a microphone. MicMixer only uses the input end; the output end is chosen in your game or chat."/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Data="{StaticResource MicIcon}" Fill="{x:Static ui:StatusTheme.LiveBrush}" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Normal mic" Style="{StaticResource SettingsHeading}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="The microphone you actually speak into."/>
                                    <ComboBox x:Name="DryInputCombo" DisplayMemberPath="FriendlyName" SelectionChanged="OnSettingsSelectionChanged" FontSize="11.5"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Volume" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="DryLevelMeter" Grid.Column="1" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                     Foreground="{x:Static ui:StatusTheme.LiveBrush}" Background="#E5E7EB"
                                                     ToolTip="Live level of the normal mic while routing is on"/>
                                        <Slider x:Name="NormalMicVolumeSlider" Grid.Column="2" Minimum="0" Maximum="2" Value="1" Margin="12,0,8,0"
                                                SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center"
                                                AutomationProperties.Name="Normal mic volume" ValueChanged="OnNormalMicVolumeChanged"/>
                                        <TextBlock x:Name="NormalMicVolumePercentText" Grid.Column="3" Text="100 %" Width="42"
                                                   TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SettingsDesc}" Margin="0,6,0,0"
                                               Text="From 0 to 200 %. 100 % sends the mic exactly as it comes in. The bar shows the level while routing is on."/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Data="{StaticResource ModdedMicIcon}" Fill="{x:Static ui:StatusTheme.ModdedBrush}" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Voice changer" Style="{StaticResource SettingsHeading}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="What others hear instead of your normal mic while you hold the hotkey: a voice changer app such as Voicemod, or MicMixer voices, which change your voice inside MicMixer itself. Also switchable from the main window."/>
                                    <ComboBox x:Name="ModdedInputCombo" DisplayMemberPath="FriendlyName" SelectionChanged="OnSettingsSelectionChanged" FontSize="11.5"
                                              AutomationProperties.Name="Voice changer"
                                              ToolTipService.ShowOnDisabled="True"/>
                                    <StackPanel x:Name="ModifiedVoicePanel" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="ModifiedVoiceTitle" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ExternalModdedInputCombo" DisplayMemberPath="FriendlyName"
                                                      SelectionChanged="OnSettingsSelectionChanged" FontSize="11.5" Visibility="Collapsed"
                                                      AutomationProperties.Name="External modified microphone"/>
                                            <ComboBox x:Name="VoiceProfileCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectionChanged="OnVoiceProfileChanged" FontSize="11.5" Visibility="Collapsed"
                                                      AutomationProperties.Name="MicMixer voice"/>
                                            <Button x:Name="CreateVoiceButton" Grid.Column="1" Content="Create a voice…" Click="OnCreateVoice"
                                                    Margin="8,0,0,0" Padding="10,4" FontSize="11.5" Visibility="Collapsed"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Record a sample, shape a voice and save it as a local profile."/>
                                            <Button x:Name="DeleteVoiceButton" Grid.Column="2" Content="Delete" Click="OnDeleteVoice"
                                                    Margin="6,0,0,0" Padding="10,4" FontSize="11.5" Visibility="Collapsed"
                                                    AutomationProperties.Name="Delete the selected voice"
                                                    ToolTipService.ShowOnDisabled="True"/>
                                        </Grid>
                                        <TextBlock x:Name="ModifiedVoiceMessage" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                                        <CheckBox x:Name="LongerAnalysisWindowCheck" Margin="0,8,0,0" FontSize="11"
                                                  Foreground="#475569"
                                                  Checked="OnLongerAnalysisWindowChanged" Unchecked="OnLongerAnalysisWindowChanged"
                                                  ToolTip="Uses the other analysis window supplied by this profile. A longer window can sound smoother but adds delay. Change while routing is stopped."
                                                  Visibility="Collapsed">
                                            <TextBlock x:Name="AlternateWindowLabel" Text="Alternate processing quality" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </StackPanel>
                                    <!-- Same layout and scale as the normal mic row, so the two can be matched by
                                         eye while routing runs. Only a local profile has a level to adjust. -->
                                    <Grid x:Name="ModdedMeterPanel" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ModdedLevelLabel" Text="Volume" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="ModdedLevelMeter" Grid.Column="1" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                     Foreground="{x:Static ui:StatusTheme.ModdedBrush}" Background="#E5E7EB"
                                                     ToolTip="Live level of the modified voice while routing is on"/>
                                        <Slider x:Name="ProcessedVoiceVolumeSlider" Grid.Column="2" Minimum="0" Maximum="2" Value="1" Margin="12,0,8,0"
                                                SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center"
                                                AutomationProperties.Name="Processed voice volume" ValueChanged="OnProcessedVoiceVolumeChanged"/>
                                        <TextBlock x:Name="ProcessedVoiceVolumePercentText" Grid.Column="3" Text="100 %" Width="42"
                                                   TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Data="{StaticResource CableIcon}" Fill="#4338CA" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Virtual cable" Style="{StaticResource SettingsHeading}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Where MicMixer sends the finished mix. Choose CABLE Input here, then choose CABLE Output as the microphone in your game or chat."/>
                                    <TextBlock Text="Send the mix to" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="OutputDeviceCombo" DisplayMemberPath="FriendlyName" SelectionChanged="OnSettingsSelectionChanged" FontSize="11.5"
                                              AutomationProperties.Name="Send the mix to"/>
                                    <TextBlock x:Name="OutputCableWarningText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#B45309" Visibility="Collapsed"
                                               Text="⚠ This does not look like a virtual cable. A game or chat can only pick up the mix from a device such as CABLE Input."/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Path Data="{StaticResource HeadphonesIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Monitoring" Style="{StaticResource SettingsHeading}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Where you hear the music yourself when Monitoring is on in the music card. Choose your headphones or speakers, never the virtual cable."/>
                                    <ComboBox x:Name="MonitorDeviceCombo" FontSize="11.5"
                                              DisplayMemberPath="FriendlyName" SelectionChanged="OnMonitorDeviceSelectionChanged"
                                              AutomationProperties.Name="Monitoring device"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Click="OnRefreshClick" Padding="10,4" FontSize="11.5"
                                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"
                                            ToolTip="Read the device list again, for example after plugging in a headset. Stops routing.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource RefreshIcon}" Fill="#10233A" Style="{StaticResource SectionIcon}" Width="12" Height="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Refresh devices"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11.5">
                                        <Hyperlink Click="OnRunSetupGuideClick">Run the setup guide</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Hotkey -->
                    <TabItem Header="Hotkey">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel>
                                <StackPanel x:Name="HotkeyConfigPanel">
                                    <StackPanel Style="{StaticResource SettingsSection}">
                                        <TextBlock Text="Hotkey" Style="{StaticResource SettingsHeading}"/>
                                        <TextBlock Style="{StaticResource SettingsDesc}"
                                                   Text="Hold it to switch to the modified voice. With push-to-talk on, you are heard only while you hold it. Works everywhere, also while a game has focus."/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="8,5" CornerRadius="6" Background="White" BorderBrush="#D7DEE7" BorderThickness="1" MinWidth="100">
                                                <TextBlock x:Name="HotkeyValueText" FontWeight="SemiBold" Foreground="#10233A" FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Button x:Name="CaptureHotkeyButton" Margin="8,0,0,0" Height="28" Padding="10,0"
                                                    Click="OnCaptureHotkeyClick" Content="Change" FontSize="11.5"
                                                    Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HotkeyCaptureHintText" Margin="0,5,0,0" FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SettingsSection}">
                                        <TextBlock Text="Release delay" Style="{StaticResource SettingsHeading}"/>
                                        <TextBlock Style="{StaticResource SettingsDesc}"
                                                   Text="How long the hotkey stays engaged after you let go. 0 lets go immediately."/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="ReleaseDelayTextBox" Width="64" MaxLength="5" Height="28"
                                                     VerticalContentAlignment="Center" FontSize="12"
                                                     LostFocus="OnReleaseDelayTextBoxLostFocus" KeyDown="OnReleaseDelayTextBoxKeyDown"/>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12" Text="ms"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Outside HotkeyConfigPanel so it stays usable when the hotkey
                                     config is dimmed for the "None" modified-voice mode. -->
                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Push-to-talk" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Nothing reaches the virtual cable, neither mic nor music, until you hold the hotkey. To keep music playing, turn on Music ignores push-to-talk in the music card. What you hear in your own headphones is not affected."/>
                                    <CheckBox x:Name="PushToTalkCheck" FontSize="11.5" Foreground="#10233A"
                                              Checked="OnPushToTalkChanged" Unchecked="OnPushToTalkChanged">
                                        <TextBlock Text="Use push-to-talk" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Noise gate -->
                    <TabItem Header="Noise gate">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <TextBlock Text="Noise gate" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Style="{StaticResource SettingsDesc}"
                                           Text="Keeps the mic silent between phrases, so the virtual cable carries real silence instead of room noise and hum. Apps that use voice activation stop treating you as talking as soon as you stop. Works with push-to-talk, applies to both mics, and never touches the music."/>
                                <CheckBox x:Name="NoiseGateCheck" FontSize="11.5" Foreground="#10233A"
                                          Checked="OnNoiseGateChanged" Unchecked="OnNoiseGateChanged">
                                    <TextBlock Text="Use the noise gate" VerticalAlignment="Center"/>
                                </CheckBox>
                                <Grid x:Name="NoiseGateSettingsPanel" Margin="22,10,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Threshold" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    <Slider x:Name="NoiseGateThresholdSlider" Grid.Column="1" Minimum="-70" Maximum="-10" Value="-45" Margin="12,0,8,0"
                                            SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                            AutomationProperties.Name="Noise gate threshold" ValueChanged="OnNoiseGateThresholdChanged"/>
                                    <TextBlock x:Name="NoiseGateThresholdText" Grid.Column="2" Text="-45 dB" Width="46"
                                               TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NoiseGateStateText" Grid.Column="3" Margin="10,0,0,0" MinWidth="48"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <!-- Same dB scale as the slider and inset by half the thumb width, so the
                                         bar's edge lines up with the thumb: the level is above the threshold
                                         exactly when the bar reaches past it. -->
                                    <ProgressBar x:Name="NoiseGateLevelBar" Grid.Row="1" Grid.Column="1" Height="6" Margin="17,2,13,0"
                                                 Minimum="-70" Maximum="-10" Value="-70" Background="#E5E7EB"
                                                 Foreground="{x:Static ui:StatusTheme.StoppedInkBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"
                                               Text="Speak normally while routing is on: the bar should pass the knob while you talk and stay below it while you are quiet."/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Overlay -->
                    <TabItem Header="Overlay">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="On-screen overlay" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="A small dot in the top-right corner while routing is on, also over games in windowed or borderless mode: green = normal mic, blue = modified voice, red = muted. While music plays, a second circle shows where it goes: purple = sent, amber = monitor only, gray = blocked by push-to-talk."/>
                                    <CheckBox x:Name="OverlayIndicatorCheck" FontSize="11.5" Foreground="#10233A"
                                              Checked="OnOverlayIndicatorChanged" Unchecked="OnOverlayIndicatorChanged">
                                        <TextBlock Text="Show the overlay" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Level rings" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="A ring around each circle shows the level others hear: green is good, yellow too low or too high, red far too high. Used by both the on-screen and the stream overlay."/>
                                    <CheckBox x:Name="OverlayVolumeMeterCheck" FontSize="11.5" Foreground="#10233A"
                                              Checked="OnOverlayVolumeMeterChanged" Unchecked="OnOverlayVolumeMeterChanged">
                                        <TextBlock Text="Show level rings" VerticalAlignment="Center"/>
                                    </CheckBox>
                                    <Grid x:Name="MeterSensitivityPanel" Margin="22,8,0,0" HorizontalAlignment="Left">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="MeterSensitivityLabel" Text="Sensitivity" FontSize="11" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                                   MouseLeftButtonDown="OnMeterSensitivityLabelMouseDown"/>
                                        <Slider x:Name="MeterSensitivitySlider" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                                Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="0"
                                                ValueChanged="OnMeterSensitivityChanged"/>
                                        <TextBlock x:Name="MeterSensitivityValueText" Grid.Column="2" Text="±0 dB" FontSize="11"
                                                   Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   MinWidth="42" TextAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0" Style="{StaticResource SettingsDesc}"
                                                   Text="If others say you sound louder than the rings show, raise it. If they say you sound quieter, lower it. Double-click Sensitivity to reset."/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Stream overlay" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Serves the same overlay as a small local web page, for streaming software that captures only the game. Add the address as a browser source, for example 232 × 116. Only this computer can open it, and it sends status and levels, never audio."/>
                                    <CheckBox x:Name="ObsOverlayCheck" FontSize="11.5" Foreground="#10233A"
                                              Checked="OnObsOverlayChanged" Unchecked="OnObsOverlayChanged">
                                        <TextBlock Text="Serve the stream overlay" VerticalAlignment="Center"/>
                                    </CheckBox>
                                    <StackPanel x:Name="ObsOverlayDetailsPanel" Margin="22,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Port" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="ObsOverlayPortBox" Width="56" MaxLength="5" Height="24" FontSize="11"
                                                     VerticalContentAlignment="Center"
                                                     LostFocus="OnObsOverlayPortBoxLostFocus" KeyDown="OnObsOverlayPortBoxKeyDown"
                                                     ToolTip="Change it only if another application is using the port."/>
                                            <Button Content="Copy address" Margin="10,0,0,0" Padding="8,2" FontSize="11"
                                                    VerticalAlignment="Center" Click="OnObsOverlayCopyClick"/>
                                        </StackPanel>
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap">
                                            <Hyperlink Click="OnObsOverlayLinkClick" ToolTip="Open the overlay page in your browser to test it.">
                                                <Run x:Name="ObsOverlayLinkText"/>
                                            </Hyperlink><Run x:Name="ObsOverlayClientsText"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Secondary output: optional fanout of the finished mix, tapped before
                         the push-to-talk gate. Off by default; the cable path is untouched. -->
                    <TabItem x:Name="SecondaryOutputPage" Header="Secondary output">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Path Data="{StaticResource SpeakerIcon}" Fill="#0E7490" Style="{StaticResource SectionIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Secondary output" Style="{StaticResource SettingsHeading}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsDesc}"
                                           Text="Plays the same mix that goes to the virtual cable, mic and music, on one more device. Typically one your streaming or recording software captures. The cable is not affected. Unlike Monitoring, which plays only the music, this includes your voice."/>
                                <CheckBox x:Name="SecondaryOutputEnabledCheck" FontSize="11.5" Foreground="#10233A"
                                          Checked="OnSecondaryOutputConfigChanged" Unchecked="OnSecondaryOutputConfigChanged">
                                    <TextBlock Text="Also play the mix on a second device" VerticalAlignment="Center"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource SettingsDesc}" Margin="22,2,0,0" Text="Takes effect the next time routing starts."/>

                                <StackPanel x:Name="SecondaryOutputConfigPanel" Margin="22,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <ComboBox x:Name="SecondaryOutputCombo" DisplayMemberPath="FriendlyName" FontSize="11.5"
                                              SelectionChanged="OnSecondaryOutputDeviceChanged"
                                              AutomationProperties.Name="Secondary output device"/>
                                    <TextBlock x:Name="SecondaryOutputWarningText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#B91C1C" Visibility="Collapsed"/>

                                    <CheckBox x:Name="SecondaryIgnorePttCheck" Margin="0,10,0,0" FontSize="11.5" Foreground="#10233A" IsChecked="True"
                                              Checked="OnSecondaryOutputConfigChanged" Unchecked="OnSecondaryOutputConfigChanged">
                                        <TextBlock Text="Ignore push-to-talk" VerticalAlignment="Center"/>
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource SettingsDesc}" Margin="22,2,0,0"
                                               Text="On: this device always gets your mic, even while push-to-talk keeps the cable silent, so a recording has everything you say. Off: the mic here follows push-to-talk."/>

                                    <Grid Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Volume" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SecondaryVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1"
                                                VerticalAlignment="Center" LargeChange="0" SmallChange="0.05"
                                                ValueChanged="OnSecondaryVolumeChanged"
                                                ToolTip="Volume for this device only. Does not affect the cable."/>
                                        <TextBlock x:Name="SecondaryVolumePercentText" Grid.Column="2" Text="100 %" FontSize="11" Foreground="#10233A"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
                                    </Grid>

                                    <TextBlock x:Name="SecondaryOutputStatusText" Margin="0,8,0,0" FontSize="11" Foreground="#9CA3AF"
                                               TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Music folders -->
                    <TabItem Header="Music folders">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel Style="{StaticResource SettingsSection}">
                                <TextBlock Text="Music folders" Style="{StaticResource SettingsHeading}"/>
                                <TextBlock Style="{StaticResource SettingsDesc}"
                                           Text="The playlist shows the MP3 files in these folders. With more than one folder, each track gets a colored letter, and you choose the download folder next to the Download button. Folder changes are saved right away."/>
                                <ItemsControl x:Name="MusicFoldersList" Focusable="False" Margin="0,2,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8,5" CornerRadius="6" Background="White" BorderBrush="#D7DEE7" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Tint}" CornerRadius="6" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Letter}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Accent}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11.5" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                    <Button Grid.Column="2" Content="Remove" Click="OnRemoveMusicFolderClick" Margin="8,0,0,0" Padding="8,2" FontSize="11"
                                                            IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ToolTipService.ShowOnDisabled="True" ToolTip="At least one music folder must remain."/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Add folder…" Click="OnAddMusicFolderClick" Padding="10,4" FontSize="11.5"
                                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                                    <Button x:Name="ResetMusicFoldersButton" Content="Use only the default folder" Click="OnResetMusicFoldersClick"
                                            Margin="8,0,0,0" Padding="10,4" FontSize="11.5"
                                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- General -->
                    <TabItem Header="General">
                        <ScrollViewer Style="{StaticResource SettingsPage}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Starts MicMixer hidden in the system tray when you sign in, without opening this window."/>
                                    <CheckBox x:Name="StartWithWindowsCheck" FontSize="11.5" Foreground="#10233A"
                                              Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged">
                                        <TextBlock Text="Start MicMixer with Windows" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Setup guide" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="Walks through what MicMixer does, the virtual cable, your devices and the hotkey. Your current choices are filled in, and nothing changes unless you click Finish."/>
                                    <Button Content="Run the setup guide…" Click="OnRunSetupGuideClick" HorizontalAlignment="Left" Padding="10,4" FontSize="11.5"
                                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="Help" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock FontSize="11.5" Margin="0,2,0,0">
                                        <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OnGuideNavigate">Download VB-CABLE ↗</Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="11.5" Margin="0,6,0,0">
                                        <Hyperlink NavigateUri="https://benjibutten.github.io/MicMixer/#guides" RequestNavigate="OnGuideNavigate">All guides ↗</Hyperlink>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SettingsSection}">
                                    <TextBlock Text="About" Style="{StaticResource SettingsHeading}"/>
                                    <TextBlock Style="{StaticResource SettingsDesc}"
                                               Text="License, source code, third-party notices and update checks."/>
                                    <Button Content="About MicMixer…" Click="OnAboutClick" HorizontalAlignment="Left" Padding="10,4" FontSize="11.5"
                                            Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Save bar: changes apply live, but only Save makes them the reference the
                     main window compares against (and what MicMixer starts with). -->
                <Border Grid.Row="2" Padding="16,10" Background="White" BorderBrush="#E5EAF0" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsSaveStateText" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="DiscardSettingsButton" Grid.Column="1" Content="Discard changes" Click="OnDiscardSettingsClick"
                                Margin="12,0,0,0" Height="30" Padding="12,0" FontSize="11.5"
                                Background="#E8EEF5" Foreground="#10233A" BorderBrush="#D7DEE7" BorderThickness="1"/>
                        <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="Save" Click="OnSaveSettingsClick"
                                Margin="8,0,0,0" Height="30" Padding="18,0" FontSize="11.5" FontWeight="SemiBold"
                                Background="#10233A" Foreground="White" BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
